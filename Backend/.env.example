# Copy this file to .env and fill in your values:
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
#
# Get a free Groq API key at: https://console.groq.com

# Required: Groq API Key for LLM
GROQ_API_KEY=your_groq_api_key_here

# Optional: JWT Secret Key (defaults to GROQ_API_KEY if not set)
# In production, set this to a strong random string
# SECRET_KEY=your-super-secret-key-change-this

# Optional: CORS origins (comma-separated)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Environment (development or production)
# ENVIRONMENT=development
